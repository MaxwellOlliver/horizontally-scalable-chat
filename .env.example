# --- docker-compose shared config (T9) -------------------------------------
# Copy to `.env` (which is gitignored) and fill in real values before `up`.
#
# The JWT_SECRET + JWT_ISSUER below are delivered to BOTH auth-service and
# ws-gateway-go so the gateway can verify access tokens locally without calling
# the app tier (specs/auth.spec.md §2.8, AC-W2). They MUST be identical for the
# two services — compose wires them from these single values.

# HS256 signing secret shared by auth-service (mints) and gateway (verifies).
# Must be long & random; min 32 chars.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# JWT `iss` claim, shared by both services.
JWT_ISSUER=hsc-auth

# Access/refresh token TTLs (auth-service only). Spec: access 10 min, refresh 15 days.
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=1296000

# First-frame WS auth timeout for the gateway (spec: 5s -> close 4408).
WS_AUTH_TIMEOUT_SECONDS=5

# Presence TTL (gateway): lifetime of a connection's presence between heartbeats.
# A missed heartbeat lets it expire to offline — self-healing (REQUIREMENTS §5.3).
PRESENCE_TTL_SECONDS=30

# Postgres credentials (auth-service DATABASE_URL is composed from these).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hsc
# Host port Postgres is published on, so services run locally (outside compose)
# can reach it at localhost:${POSTGRES_PORT}.
POSTGRES_PORT=5432

# Redis — per-user pub/sub delivery channels (user:{id}) for real-time pushes.
# Host port published so a service run locally can reach it at localhost:${REDIS_PORT};
# in-compose services use redis://redis:6379.
REDIS_PORT=6379

# RabbitMQ — event bus for the domain.events topic exchange that carries
# friend_request.* / friendship.removed integration events (friends.specs.md
# §2.4a). These seed the broker's default user; 5672 = AMQP, 15672 = mgmt UI.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Host port Nginx publishes (routes /auth/* -> app, /ws -> gateway).
HTTP_PORT=8080
