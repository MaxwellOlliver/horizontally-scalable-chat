# Client config. Copy to `.env.local` to override.

# Backend the dev server proxies the /api/* prefix to (prefix stripped before
# forwarding). Defaults to the Nginx front door published on HTTP_PORT.
VITE_PROXY_TARGET=http://localhost:8080

# Optional explicit overrides. Left blank, the client addresses the backend
# under a same-origin /api prefix (proxied in dev) and derives the WS URL from
# window.location. Set these for a cross-origin backend.
# VITE_API_BASE_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com/ws
