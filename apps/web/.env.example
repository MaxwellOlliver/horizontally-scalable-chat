# Client config. Copy to `.env.local` to override.

# Backend the dev server proxies /auth, /social, /chat, /presence, /ws to.
# Defaults to the Nginx front door published on HTTP_PORT.
VITE_PROXY_TARGET=http://localhost:8080

# Optional explicit overrides. Left blank, the client uses same-origin relative
# URLs (proxied in dev) and derives the WS URL from window.location.
# VITE_API_BASE_URL=
# VITE_WS_URL=ws://localhost:8080/ws
