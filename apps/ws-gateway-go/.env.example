# --- ws-gateway-go config (cross-language contract, specs/auth.spec.md §2.8) ---

# Listen port for the WebSocket upgrade endpoint.
PORT=8080

# Shared HS256 signing secret. MUST equal the auth-service JWT_SECRET so the
# gateway can verify access tokens locally without calling the app tier (AC-W2).
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Expected `iss` claim — MUST match the auth-service JWT_ISSUER.
JWT_ISSUER=hsc-auth

# First-frame auth timeout in seconds (spec: 5s -> close 4408 on expiry, AC-W3).
WS_AUTH_TIMEOUT_SECONDS=5

# Cross-instance presence (REQUIREMENTS §5). Shared by all gateway replicas.
REDIS_URL=redis://localhost:6379
# Presence lifetime between heartbeats; a missed heartbeat expires to offline.
PRESENCE_TTL_SECONDS=30
