# --- auth-service config (see specs/auth.spec.md §2.8) ---

# Postgres connection string for users + refresh_tokens.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hsc

# Shared HS256 signing secret. The Go gateway reads the SAME value to verify
# access tokens locally (spec §2.8). Must be long & random; min 32 chars.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# JWT claim contract (spec §2.5 / §2.8).
JWT_ISSUER=hsc-auth

# Token TTLs (spec "Decisions": access 10 min, refresh 15 days).
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=1296000

# HTTP listen port.
PORT=3000
