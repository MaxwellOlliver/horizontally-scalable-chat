# --- social-service config (specs/friends.specs.md §2.1) ---

# Shared Postgres. social-service owns friend_requests + friendships and reads
# the users table read-only for existence checks (AC-S6).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hsc

# Access-token verification. MUST match auth-service JWT_SECRET / JWT_ISSUER:
# mutations are authenticated by verifying the Bearer token locally (sub = caller).
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ISSUER=hsc-auth

# Event bus (§2.4a): friend_request.* integration events to a topic exchange.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
DOMAIN_EVENTS_EXCHANGE=domain.events

# Real-time UI push (§2.4b): per-user Redis channels user:{id}, forwarded by the
# gateway to held sockets.
REDIS_URL=redis://localhost:6379

# HTTP listen port.
PORT=3001
